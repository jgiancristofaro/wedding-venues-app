# Copy to .env.local. Leave both blank to run in Demo mode (local-only storage, mock sign-in).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: comma-separated admin emails used only to show/hide the Admin link in the UI.
# Real enforcement happens in the database (public.app_admins + RLS).
VITE_ADMIN_EMAILS=
